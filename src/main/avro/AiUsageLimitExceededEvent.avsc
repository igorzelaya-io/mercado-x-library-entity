{
  "type": "record",
  "name": "AiUsageLimitExceededEvent",
  "namespace": "hn.shadowcore.mercadox.library.entity.avro",
  "doc": "Published to ai.usage.limit.exceeded.v1 when a tenant's monthly Claude usage crosses their plan limit. Consumed by mercado-x-email to notify the org admin.",
  "fields": [
    {
      "name": "eventId",
      "type": ["null", "string"],
      "default": null,
      "doc": "UUID identifying this event. Used for idempotency deduplication in Redis."
    },
    {
      "name": "eventType",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "orgId",
      "type": ["null", "string"],
      "default": null,
      "doc": "UUID of the organization that exceeded its plan limit."
    },
    {
      "name": "occurredAt",
      "type": ["null", "string"],
      "default": null,
      "doc": "ISO-8601 timestamp of when the limit was crossed."
    },
    {
      "name": "plan",
      "type": ["null", "string"],
      "default": null,
      "doc": "Subscription plan the org is on — STARTER, GROWTH, or BUSINESS."
    },
    {
      "name": "monthlyLimit",
      "type": ["null", "string"],
      "default": null,
      "doc": "The monthly Claude response quota for this org's plan."
    },
    {
      "name": "allowOverage",
      "type": ["null", "string"],
      "default": null,
      "doc": "\"true\" if the org has overage billing enabled and AI replies continue past the limit; \"false\" if the service is now hard-blocked until next billing cycle."
    }
  ]
}
